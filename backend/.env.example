# Copy to backend/.env and fill in the values. backend/.env is never committed or deployed
# (.gitignore, scripts/deploy.ps1, ops/deploy.py). On the server, create it once at
# /home/ubuntu/kirothon/backend/.env with permission 600. Values already set in the process
# environment (systemd, PowerShell $env:) win over this file.

# ---- External API keys ---------------------------------------------------------------------
# Kakao Local REST API key (place search). Empty -> demo points.
KAKAO_REST_API_KEY=
# data.go.kr service key for KMA (rainfall, heavy-rain alerts). Empty -> demo weather.
KMA_SERVICE_KEY=

# ---- Amazon Bedrock (AI route explanation) -------------------------------------------------
# No AWS access keys here: the server uses its EC2 IAM role (.kiro/steering/aws.md).
# mock = no AWS call, template sentences only. bedrock = real call (server default).
# scripts/dev-backend*.ps1 force mock locally.
KIROTHON_AI_MODE=bedrock
KIROTHON_BEDROCK_REGION=ap-northeast-1
# Must be one of the models allowed in backend/app/ai_service.py.
KIROTHON_EXPLAIN_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Seconds to wait for the explanation before the template is used (1-30).
KIROTHON_EXPLAIN_TIMEOUT_S=8
# Bedrock Guardrails (contextual grounding + word filter). Empty ID -> local checks only.
KIROTHON_BEDROCK_GUARDRAIL_ID=
KIROTHON_BEDROCK_GUARDRAIL_VERSION=DRAFT

# ---- Routing -------------------------------------------------------------------------------
# Valhalla config path. Empty -> .local-data/valhalla/valhalla.json
VALHALLA_CONFIG=
# Route request time limit in seconds. Empty -> strategies.yaml engine.timeout_s (10)
ROUTING_TIMEOUT_S=
