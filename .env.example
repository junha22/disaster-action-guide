# Local development only: copy to .env, read by scripts/dev-backend-conda.ps1. The server reads backend/.env instead
# (all settings are listed in backend/.env.example). .env is git-ignored and never deployed; do not commit real keys.
# Kakao REST API key. Empty: demo points only.
KAKAO_REST_API_KEY=
# KMA key from apihub.kma.go.kr or data.go.kr. Empty: demo weather only.
KMA_SERVICE_KEY=
